<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>게시글 - ChatClub</title>
    <style>
        :root {
            --bg-color: #05070a;
            --card-bg: #121620;
            --text-color: #ffffff;
            --text-muted: #94a3b8;
            --gradient-main: linear-gradient(135deg, #00c6ff, #0072ff, #00f260);
            --border-color: #1e293b;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: var(--bg-color); color: var(--text-color);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            display: flex; justify-content: center;
        }
        .container {
            width: 100%; max-width: 500px; min-height: 100vh;
            display: flex; flex-direction: column;
            border-left: 1px solid var(--border-color); border-right: 1px solid var(--border-color);
        }
        .header {
            display: flex; align-items: center; padding: 15px 20px;
            border-bottom: 1px solid var(--border-color);
            background-color: rgba(5, 7, 10, 0.9); backdrop-filter: blur(12px);
            position: sticky; top: 0;
        }
        .header a { color: var(--text-color); text-decoration: none; font-size: 1.3rem; font-weight: bold; margin-right: 15px; }
        .header .title { font-weight: 700; font-size: 1.1rem; }

        .content { flex: 1; padding: 20px; display: flex; flex-direction: column; gap: 15px; }
        .card { background-color: var(--card-bg); border: 1px solid var(--border-color); border-radius: 14px; padding: 16px; }

        .post-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
        .author { display: flex; align-items: center; gap: 6px; text-decoration: none; color: white; }
        .nickname { font-weight: bold; font-size: 0.95rem; }
        .username { color: var(--text-muted); font-size: 0.8rem; }
        .time { font-size: 0.75rem; color: var(--text-muted); }
        .post-content { font-size: 0.95rem; line-height: 1.6; white-space: pre-wrap; word-break: break-all; margin-bottom: 14px; }

        .post-img { display: block; width: 100%; border-radius: 10px; margin-bottom: 12px; cursor: zoom-in; background: var(--border-color); }
        .actions { display: flex; justify-content: space-between; align-items: center; }
        .action-btn {
            background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border-color); color: var(--text-muted);
            padding: 6px 12px; border-radius: 16px; font-size: 0.8rem; font-weight: bold;
            cursor: pointer; display: inline-flex; align-items: center; gap: 4px;
        }
        .action-btn.liked { color: #ff4d6d; border-color: rgba(255, 77, 109, 0.5); background: rgba(255, 77, 109, 0.1); }
        .delete-btn { background: none; border: none; color: #ef4444; font-size: 0.8rem; font-weight: 600; cursor: pointer; }

        .section-title { font-size: 1rem; font-weight: 700; margin-bottom: 12px; }
        .comment { padding: 12px 0; border-bottom: 1px solid var(--border-color); }
        .comment:last-child { border-bottom: none; }
        .comment-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
        .comment-text { font-size: 0.9rem; line-height: 1.5; white-space: pre-wrap; word-break: break-all; }
        .empty-text { color: var(--text-muted); font-size: 0.85rem; text-align: center; padding: 15px 0; }

        .comment-form {
            position: sticky; bottom: 0; padding: 15px 20px;
            border-top: 1px solid var(--border-color); background-color: var(--bg-color);
            display: flex; gap: 10px;
        }
        .comment-form input {
            flex: 1; background-color: var(--card-bg); border: 1px solid var(--border-color);
            border-radius: 24px; padding: 12px 18px; color: white; font-size: 0.9rem; outline: none;
        }
        .comment-form button {
            background: var(--gradient-main); color: white; border: none; font-weight: 700;
            padding: 0 20px; border-radius: 24px; cursor: pointer; font-size: 0.9rem;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <a href="{{ url_for('index', tab='community') }}">❮</a>
        <div class="title">게시글</div>
    </div>

    <div class="content">
        <!-- 게시글 본문 -->
        <div class="card">
            <div class="post-head">
                <a href="{{ url_for('user_profile', username=post.author_id) }}" class="author">
                    <span class="nickname">{{ post.nickname }}</span>
                    <span class="username">@{{ post.author_id }}</span>
                </a>
                <span class="time">{{ post.created_at.strftime('%m-%d %H:%M') if post.created_at else '' }}</span>
            </div>
            {% if post.image_url %}<img src="{{ post.image_url }}" alt="첨부 사진" class="post-img" onclick="window.open(this.src, '_blank')">{% endif %}
            {% if post.content %}<div class="post-content">{{ post.content }}</div>{% endif %}
            <div class="actions">
                <button type="button" class="action-btn like-btn {% if post.is_liked %}liked{% endif %}" data-post-id="{{ post.id }}">
                    <span class="like-icon">{% if post.is_liked %}❤️{% else %}🤍{% endif %}</span>
                    <span class="like-count">{{ post.like_count }}</span>
                </button>
                {% if post.author_id == my_id or is_admin %}
                    <form action="{{ url_for('delete_community_post', post_id=post.id) }}" method="POST" onsubmit="return confirm('이 게시글을 삭제할까요?');">
                        <button type="submit" class="delete-btn">🗑️ 게시글 삭제</button>
                    </form>
                {% endif %}
            </div>
        </div>

        <!-- 댓글 목록 -->
        <div class="card">
            <div class="section-title">💬 댓글 {{ comments|length }}</div>
            {% for c in comments %}
                <div class="comment">
                    <div class="comment-head">
                        <a href="{{ url_for('user_profile', username=c.author_id) }}" class="author">
                            <span class="nickname" style="font-size: 0.85rem;">{{ c.nickname }}</span>
                            <span class="username">@{{ c.author_id }}</span>
                        </a>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span class="time">{{ c.created_at.strftime('%m-%d %H:%M') if c.created_at else '' }}</span>
                            {% if c.author_id == my_id or post.author_id == my_id or is_admin %}
                                <form action="{{ url_for('delete_community_comment', comment_id=c.id) }}" method="POST" onsubmit="return confirm('이 댓글을 삭제할까요?');">
                                    <button type="submit" class="delete-btn">삭제</button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                    <div class="comment-text">{{ c.comment }}</div>
                </div>
            {% else %}
                <div class="empty-text">첫 댓글을 남겨보세요! 💭</div>
            {% endfor %}
        </div>
    </div>

    <!-- 댓글 입력 -->
    <form action="{{ url_for('add_post_comment', post_id=post.id) }}" method="POST" class="comment-form">
        <input type="text" name="comment" placeholder="댓글을 입력하세요..." maxlength="500" required autocomplete="off">
        <button type="submit">등록</button>
    </form>
</div>

<script>
    document.querySelectorAll('.like-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            const postId = this.getAttribute('data-post-id');
            this.disabled = true;
            fetch(`/community/post/${postId}/like`, { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        this.classList.toggle('liked', data.is_liked);
                        this.querySelector('.like-icon').textContent = data.is_liked ? '❤️' : '🤍';
                        this.querySelector('.like-count').textContent = data.like_count;
                    } else {
                        alert(data.message || '좋아요 처리에 실패했습니다.');
                    }
                })
                .catch(() => alert('서버와 연결할 수 없습니다.'))
                .finally(() => { this.disabled = false; });
        });
    });
</script>
</body>
</html>
